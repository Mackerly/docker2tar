. /lib/functions.sh
. /lib/functions/service.sh

SCRIPT_NAME=$(basename "$0")

global=0
config_file="/etc/config/samba4"

wait_for_init() {
	for i in `seq 30`
	do
		[ -e /tmp/procd.done ] || {
		sleep 1; continue;
		}
		return
	done
}

smb_handle() {
	config_get path $1 path
	if [  "$path" = "$2" ] ;then
		global=1
	fi
}

chk_en() {
	config_get_bool autoshare $1 autoshare 1
	[ $autoshare -eq 0 ] && exit
}

config_load samba
config_foreach chk_en samba

device=`basename $DEVPATH`

case "$ACTION" in
	add)

	echo "<5> $SCRIPT_NAME is run 20 samba" > /dev/kmsg
        logger -t "$SCRIPT_NAME"
	case "$device" in
		sd*);;
		md*);;
		hd*);;
		mmcblk*);;
		*) return;; # 其他设备（比如 loop 设备、ramdisk 等）直接退出
	esac

    # 拼出完整的设备路径，如 /dev/sda1
	path="/dev/$device"

	wait_for_init

	cat /proc/mounts | while read j
	do
		# j 的格式示例：
		# /dev/sda1 /mnt/sda1 ext4 rw,relatime 0 0

		# str = 第一列（设备路径）
		str=${j%% *}   # 从右边删除最长匹配的 " *" → 得到 /dev/sda1

		if [ "$str" == $path ];then
		    
			# 找到了！这个设备被挂载了
			strr=${j#* }   # 删除最左边的非空字段和空格

			# target = 挂载点路径，例如 /mnt/sda1
			target=${strr%% *}       # 从右边删除第一个空格之后的所有内容

			# global 变量：用来标记是否“已经处理过”或“已有全局配置”
			global=0

			# 调用 config_foreach 遍历所有 sambashare 配置项
            # smb_handle 应该是一个自定义的 shell 函数，用来检查这个挂载点是否已经存在共享
            # 如果存在，函数内部通常会把 global 设为 1（但原脚本中这个逻辑似乎不完整）
			if config_foreach smb_handle sambashare $target 2>/dev/null;then
			   global=1
			fi

			# 从挂载点提取共享名称（去掉 /mnt/ 前缀）
			# 例如 /mnt/sda1 → sda1
			#     /mnt/SSD → SSD
			name=${target#*/mnt/}

			# 如果 global 还是 0，说明没有找到已存在的共享配置 → 需要新建
			if [ $global -eq 0 ] ;then
				echo -e "\n\nconfig sambashare" >> $config_file
				echo -e "\toption auto '1'" >> $config_file
				echo -e "\toption name '$name'qq" >> $config_file
				echo -e "\toption path '$target'" >> $config_file
				echo -e "\toption read_only 'no'" >> $config_file
				echo -e "\toption guest_ok 'yes'" >> $config_file
				echo -e "\toption create_mask '0666'" >> $config_file
				echo -e "\toption dir_mask '0777'" >> $config_file
				echo -e "\toption device '$device'" >> $config_file
				/etc/init.d/samba4 reload

				# return 这里其实是退出 while 循环（因为已经处理完这个设备）
				return
			fi

			# 如果 global != 0，说明已经存在共享配置，就什么都不做，直接跳过

		fi
	done
	;;

	remove)
		i=0
		while true
		do
			dev=`uci get samba4.@sambashare[$i].device`
			[ $? -ne 0 ] && break

			[ "$dev" = "$device" ] && {
				auto=`uci get samba4.@sambashare[$i].auto`
				[ $auto = "1" ] && {
					mount_dir=`uci get samba4.@sambashare[$i].name`
					uci delete samba4.@sambashare[$i]
					uci commit
					/etc/init.d/samba4 reload
					return
				}
			}
			let i+=1
		done
	;;
esac
